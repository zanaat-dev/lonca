}
type SubclassOptions = Omit<LoncaErrorOptions, 'code' | 'retryable'>;
declare class AuthError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class RateLimitError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class ValidationError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class NotFoundError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class ServerError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class NetworkError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare class TimeoutError extends LoncaError {
    constructor(opts: SubclassOptions);
}
declare function isLoncaError(value: unknown): value is LoncaError;
declare function isRetryableError(value: unknown): boolean;
/**
