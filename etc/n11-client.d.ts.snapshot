    getTask(taskId: string): Promise<N11TaskDetails>;
    /**
     * Poll {@link getTask} until the task is `PROCESSED` or `REJECT`.
     *
     * @throws {TimeoutError} when it is still running after `opts.timeoutMs`.
     */
    waitForTask(taskId: string, opts?: N11TaskPollOptions): Promise<N11TaskDetails>;
}

/** Question status filter. n11 defaults to `OPEN` when none is sent. */
type N11QuestionStatus = 'OPEN' | 'CLOSED' | (string & {});
/** Filters for {@link QuestionsResource.list}. */
interface ListN11QuestionsParams extends CursorPaginationParams {
    /**
     * Window start — **required** by n11. A `Date` is sent as its Turkish
     * calendar day (`DD/MM/YYYY`); a string is sent as given.
     */
    startDate: Date | string;
    /** Window end — **required** by n11. */
    endDate: Date | string;
    /** Defaults to `OPEN` server-side. */
    status?: N11QuestionStatus;
    /** n11 product code. */
    productId?: string | number;
    buyerEmail?: string;
    subject?: string;
}
/** One row of `GetProductQuestionList`. */
interface N11Question {
    id: string;
    productId?: string;
    productTitle?: string;
    subject?: string;
    question?: string;
    /** Present once answered. */
    answer?: string;
    images: string[];
    /** Untouched parsed element. */
    raw: Record<string, unknown>;
}
/** `GetProductQuestionDetail`: the question plus buyer and status fields. */
interface N11QuestionDetail {
    /** The id that was asked for (the response does not repeat it). */
    id: string;
    productId?: string;
    productTitle?: string;
    subject?: string;
    question?: string;
    answer?: string;
    /** Buyer's name. */
    fullName?: string;
    /** Buyer's e-mail. */
    email?: string;
    productStatus?: string;
    status?: string;
    /** `YYYY-MM-DD` (unlike the list filters, which take `DD/MM/YYYY`). */
    questionDate?: string;
    /** `YYYY-MM-DD`. */
    answeredDate?: string;
    /** Whether the seller's answer is shown publicly. */
    sellerExpose?: string;
    /** Whether the buyer shared the question publicly ("Özel / Genel"). */
    buyerExpose?: string;
    images: string[];
    /** Untouched parsed element. */
    raw: Record<string, unknown>;
}

/**
 * Product questions (SOAP `ProductService`).
 *
 * Source: developer.n11.com → "Ürün Soru-Cevap Servisi" and
 * `api.n11.com/ws/productService.wsdl`. Reads verified against prod on
 * 2026-10-10; `answer` on n11's test store on 2026-10-13.
