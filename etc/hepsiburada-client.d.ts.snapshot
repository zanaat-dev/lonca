    isSuspended: boolean;
    isLocked: boolean;
    lockReasons?: string[];
    isFrozen: boolean;
    freezeReasons?: string[];
    availableWarehouses?: string[];
    /**
     * `true` when this listing is fulfilled by Hepsiburada (FBH / "HepsiLojistik").
     *
