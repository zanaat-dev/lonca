}

/**
 * Hepsiburada Claims (Talep) types.
 *
 * Two backend services back this surface:
 *   - `talep-listeleme` (oms-external)        — list + accept / reject / preApproval
 *   - `talep-olusturma` (claim-stub-external) — create
 *
 * The developer portal publishes both definitions (`talep-listeleme`,
 * `talep-olusturma`); they are not in `specs/hepsiburada`. The SDK types the
 * documented body fields as hints, keeps the bodies open
 * (`Record<string, unknown>`) and surfaces responses with a typed envelope +
 * a `raw` escape hatch.
 */
/**
 * Allowed values for `claims.listByStatus(status)`. The published OpenAPI
 * spec types this as a string enum:
 * `NewRequest | Accepted | AwaitingAction | InDispute | Rejected |
 * Refunded | Cancelled | AwaitingPreApproval`. Trendyol's `Open` / `Closed`
 * naming does **not** apply — Hepsiburada returns
 * `400 "Wrong Claim Status"` for any other value.
 *
 * Open-ended to allow forward-compatibility if Hepsiburada adds a new
 * status without an SDK release; explicit literals are intellisense-friendly.
 */
type ClaimStatus = 'NewRequest' | 'Accepted' | 'AwaitingAction' | 'InDispute' | 'Rejected' | 'Refunded' | 'Cancelled' | 'AwaitingPreApproval' | (string & {});
/** A single claim row surfaced by `claims.list*()`. */
interface Claim {
    claimNumber?: string;
    status?: ClaimStatus;
    /** ISO 8601-ish; Hepsiburada returns a server-local string. */
    createdAt?: string;
    /** Untouched raw row — pull full claim fields from here. */
    raw: Record<string, unknown>;
}
/** Filter / pagination params for `claims.list()`. */
interface ListClaimsParams {
    /** Format: `yyyy-MM-dd HH:mm` (Hepsiburada's documented spelling). */
    beginDate?: string;
    /** Format: `yyyy-MM-dd HH:mm`. */
    endDate?: string;
    offset?: number;
    limit?: number;
}
/** Filter / pagination params for `claims.listByStatus()`. */
interface ListClaimsByStatusParams extends ListClaimsParams {
    /** Filter on the claim's status-change date. */
    statusBeginDate?: string;
    /** Filter on the claim's status-change date. */
    statusEndDate?: string;
}
/**
 * Payload for `claims.create()` — the portal's `CreateClaim` (`talep-olusturma`,
 * a test-environment helper): `{ orderNumber, type, reason, newSKU }`. The
 * `& Record<string, unknown>` keeps the body open so extra fields still pass
 * through verbatim.
 */
type CreateClaimInput = {
    /** Order to open the claim on. */
    orderNumber?: string;
    /**
     * Claim type: `change`, `missingitem`, `missingpart`, `missinginvoice`,
     * `extraproduct`, `return` or `renewproduct`.
     */
    type?: 'change' | 'missingitem' | 'missingpart' | 'missinginvoice' | 'extraproduct' | 'return' | 'renewproduct' | (string & {});
    /** Claim reason: `ProductIsBroken`, `ProductIsDamaged` or `WrongProductSentByMerchant`. */
    reason?: 'ProductIsBroken' | 'ProductIsDamaged' | 'WrongProductSentByMerchant' | (string & {});
    /** SKU requested in exchange (`change` / `renewproduct`). */
    newSKU?: string;
    /** @deprecated Not part of Hepsiburada's `CreateClaim` body. Will be removed in the next major. */
    lines?: unknown[];
} & Record<string, unknown>;
/**
 * Payload for `claims.accept()` / `claims.reject()` / `claims.preApprovalConfirm()`
 * — the portal's `AcceptClaimRequest`, `RejectClaimRequest` and
 * `PreApprovalConfirmRequest` (`talep-listeleme`). The fields are typed as
 * hints and the body stays open for the rest.
 */
type ClaimActionInput = {
    /**
     * `accept`: how the claim is settled — `Refund` (pay the money back) or
     * `Change` (send a new product). An exchange claim accepted without a body
     * is settled as `Change`.
     */
    FinalizedWith?: 'Refund' | 'Change' | (string & {});
    /**
     * `accept`: reason for settling a new-product claim with a refund —
     * `StockProblem`, `ProductNotDefective` or `Other`.
     */
    AcceptionReason?: string;
    /** `accept`: invoice link. */
    InvoiceLink?: string;
    /**
     * `reject`: rejection reason from Hepsiburada's list, e.g.
     * `CustomerReturnedWrongItem`, `ProductIsDamaged`, `MissingQuantity`,
     * `ProductNotDefective` (returns and renewals) or `ProductSentComplete`,
     * `MissingItemOrPartCannotBeSupplied`, `Other` (missing item / part).
     */
    ClaimRejectionReason?: string;
    /**
     * `reject`: the merchant's statement. A reject with only this field was
     * accepted (`204`, SIT 2026-10-27); an empty body is refused.
     */
    MerchantStatement?: string;
    /** `reject`: report references. */
    Reports?: string[];
    /** `reject`: URLs of uploaded reports. */
    UploadedReportsUrls?: string[];
    /**
     * `preApprovalConfirm`: the only accepted value is `ProductInvestigation`
     * ("send the product to me, I will inspect it"); the SDK sends it when the
     * input has none.
     */
    preApprovalReason?: 'ProductInvestigation' | (string & {});
    /**
     * @deprecated Hepsiburada reads no `reasonCode`. Use `ClaimRejectionReason`
     *   (`reject`) or `AcceptionReason` (`accept`). Will be removed in the next major.
     */
    reasonCode?: string;
    /**
     * @deprecated Hepsiburada reads no `confirmed` flag; `preApprovalConfirm`
     *   needs `preApprovalReason` (the SDK fills it in). Will be removed in the
     *   next major.
     */
    confirmed?: boolean;
} & Record<string, unknown>;

/**
 * Hepsiburada Claims (Talep) — list, status-based filtering, and
 * accept/reject/preApproval actions plus claim creation.
 *
 * **Two backend services** back this surface (the SDK routes
 * automatically; callers don't pick):
 *
 *   - List + actions: `oms-external[-sit].hepsiburada.com` (`talep-listeleme`)
 *   - Create: `claim-stub-external[-sit].hepsiburada.com` (`talep-olusturma`)
 *
 * Body shapes for `accept`, `reject`, `preApprovalConfirm`, and `create`
 * are documented on the developer portal (`talep-listeleme`,
 * `talep-olusturma`) and typed as hints on `ClaimActionInput` /
 * `CreateClaimInput`; the SDK passes them through so future field additions
 * don't break callers.
 */
declare class ClaimsResource {
    private readonly transport;
    private readonly limiter;
    constructor(transport: HepsiburadaTransport, limiter?: TokenBucketRateLimiter);
    /**
     * List all claims. Date-range filters are optional; `offset`/`limit` default
     * to `0`/`100` because Hepsiburada rejects a missing `limit` (`400
     * "LimitCannotBeEmpty"`). Pass your own to paginate.
     */
    list(params?: ListClaimsParams): Promise<Claim[]>;
    /**
     * List claims filtered to a specific status.
     *
     * Allowed values (per the published OpenAPI spec, verified live):
     * `NewRequest | Accepted | AwaitingAction | InDispute | Rejected |
     * Refunded | Cancelled | AwaitingPreApproval`. Any other value returns
     * `400 "Wrong Claim Status"` from Hepsiburada.
     *
     * @throws {ValidationError} when `status` is empty.
     */
    listByStatus(status: ClaimStatus, params?: ListClaimsByStatusParams): Promise<Claim[]>;
    /**
     * Accept (approve) a customer claim — the portal's `AcceptClaimRequest`:
     * `FinalizedWith` (`Refund` / `Change`), `AcceptionReason`, `InvoiceLink`.
     */
    accept(claimNumber: string, input?: ClaimActionInput): Promise<MutationResult>;
    /**
     * Reject a customer claim (the claim goes to `InDispute`) — the portal's
     * `RejectClaimRequest`: `ClaimRejectionReason` (a value from Hepsiburada's
     * list, see `ClaimActionInput`), `MerchantStatement`, `Reports`,
     * `UploadedReportsUrls`. Send at least the reason and the statement.
     *
     * @throws {ValidationError} when `claimNumber` is missing or `input` is
     *   empty (Hepsiburada refuses an empty body with a bare `400`).
     */
    reject(claimNumber: string, input?: ClaimActionInput): Promise<MutationResult>;
    /**
     * Confirm an `AwaitingPreApproval` claim with "send the product to me, I
     * will inspect it" — the portal's `PreApprovalConfirmRequest`
     * (`{ preApprovalReason: 'ProductInvestigation' }`, the only accepted
     * value). The SDK sends that reason when `input` carries none, so
     * `preApprovalConfirm(claimNumber)` is enough. A claim in another status is
     * refused with `400 "Claim is not in AwaitingPreApproval status"`.
     */
    preApprovalConfirm(claimNumber: string, input?: ClaimActionInput): Promise<MutationResult>;
    /**
     * Create a claim on an order — a test-environment helper (`claim-stub`
     * service) taking the portal's `CreateClaim` body
     * (`{ orderNumber, type, reason, newSKU }`).
     *
     * Hepsiburada answers a failed create with `200` and puts the failure text
     * where the claim number belongs (`{ ClaimList: [{ claimNumber: "Claim
     * oluşturulamadı.", type: "" }] }`, SIT 2026-10-27); the SDK throws that as
     * a `ValidationError` (`status` 200, the body on `error.data.body`).
     *
     * @throws {ValidationError} when `input` is missing, or when a `ClaimList`
     *   entry carries no claim number.
     */
    create(input: CreateClaimInput): Promise<MutationResult>;
}

/**
 * Hepsiburada Listings (Listeleme) types.
 *
 * Shape source: official OpenAPI document at
 * developers.hepsiburada.com/api/v1/public/docs/hepsiburada/listeleme/v1/openapi
 * (HEPSIBURADA - LISTELEME ENTEGRASYONU v1, 17 operations / 25 schemas).
 */

/** Pricing window for a listing (date-bounded promo, contract pricing, etc.). */
interface ListingPricing {
    finalPrice: number;
