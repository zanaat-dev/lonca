{
  "name": "@lonca/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Lonca — open-source SDKs and tooling for Turkish e-commerce marketplaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zanaat-dev/lonca.git"
  },
  "homepage": "https://github.com/zanaat-dev/lonca",
  "bugs": {
    "url": "https://github.com/zanaat-dev/lonca/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:root": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "health:packages": "tsx scripts/health-packages.mts",
    "api:check": "tsx scripts/api-surface.mts --check",
    "api:update": "tsx scripts/api-surface.mts --update",
    "docs:dev": "pnpm --filter @lonca/docs dev",
    "docs:build": "pnpm --filter @lonca/docs build",
    "docs:preview": "pnpm --filter @lonca/docs preview",
    "docs:check-links": "pnpm --filter @lonca/docs check-links",
    "docs:sync-brand": "pnpm --filter @lonca/docs sync-brand",
    "try:trendyol": "tsx --env-file=.env examples/try-trendyol.mts",
    "try:hepsiburada": "tsx --env-file=.env examples/try-hepsiburada.mts",
    "try:inspect-hb-categories": "tsx --env-file=.env examples/inspect-hb-categories.mts",
    "try:inspect-hb-orders": "tsx --env-file=.env examples/inspect-hb-orders.mts",
    "try:inspect-hb-catalog": "tsx --env-file=.env examples/inspect-hb-catalog.mts",
    "try:inspect-orders": "tsx --env-file=.env examples/inspect-orders.mts",
    "try:inspect-attribute-values": "tsx --env-file=.env examples/inspect-attribute-values.mts",
    "try:inspect-product-reads": "tsx --env-file=.env examples/inspect-product-reads.mts",
    "try:inspect-inventory-and-price": "tsx --env-file=.env examples/inspect-inventory-and-price.mts",
    "probe": "tsx --env-file-if-exists=.env scripts/probe/run.mts",
    "probe:check": "tsx --env-file-if-exists=.env scripts/probe/run.mts --check",
    "probe:prod": "tsx --env-file=.env.prod scripts/probe/run.mts",
    "e2e:hepsiburada": "tsx --env-file=.env scripts/e2e/hepsiburada.mts",
    "e2e:n11": "tsx --env-file=.env.n11-test scripts/e2e/n11.mts",
    "e2e:trendyol": "tsx --env-file=.env scripts/e2e/trendyol.mts",
    "drift:requests": "tsx scripts/probe/requests/run.mts",
    "probe:hosts": "tsx --env-file-if-exists=.env scripts/probe/host-check.mts",
    "drift": "tsx packages/drift/src/bin.ts",
    "drift:types": "tsx packages/drift/src/types-bin.ts",
    "specs:trendyol:fetch": "node scripts/specs/fetch-trendyol.mjs --out trendyol-reference-capture.json",
    "specs:trendyol:build": "node scripts/specs/build-trendyol.mjs trendyol-reference-capture.json",
    "specs:trendyol:check": "node scripts/specs/build-trendyol.mjs trendyol-reference-capture.json --check",
    "specs:trendyol:coverage": "node scripts/specs/coverage-trendyol.mjs",
    "specs:n11:build": "node scripts/specs/build-n11.mjs",
    "specs:n11:check": "node scripts/specs/build-n11.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "publint": "0.3.25",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
