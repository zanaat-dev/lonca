    "/rest/delivery/v1/collectionRequest": {
      "put": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Toplama Talebi Oluşturma",
        "operationId": "createCollectionRequest",
        "description": "GetShipmentPackages servisinden Picking dönen kalemler için lojistik firma (Horoz, Ceva, Borusan) toplama talebi oluşturur. Paketteki tüm sipariş kalemleri için istek gönderilmelidir; eksik ya da hatalı gönderimde \"Eksik ya da uygun olmayan sipariş öğesi bulunmaktadır.\" hatası alınır.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
