                "schema": {
                  "$ref": "#/components/schemas/CodeMessage"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/toplama-talebi-olusturma/"
