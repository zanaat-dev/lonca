    "/rest/delivery/v1/shipmentPackages": {
      "get": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Sipariş Listeleme Servisi",
        "operationId": "getShipmentPackages",
        "description": "Servise 1 dakika içinde maksimum 1000 istek atılabilir. status her istekte tek bir değer alır. 2024 Kasım öncesi sipariş verisi bu servisten verilmez. Sonuçlar son güncelleme tarihine göre sıralanır (orderByDirection). Yalnızca startDate girilirse sonraki 15 günün, yalnızca endDate girilirse önceki 15 günün kayıtları listelenir; iki tarih arasında çok fark varsa endDate'ten önceki son 15 gün listelenir. Satır bazlı fatura tutarı: (price * quantity) - (sellerDiscount + sellerCouponDiscount) = sellerInvoiceAmount. Konuma Özel Teslimat siparişlerinde paket numarası (id) null döner. sender gönderilmediğinde mağaza siparişleri listelenir. orderNumber 12 haneden 13 haneye çıkabilir.",
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "description": "Belirtilen tarihten sonraki siparişleri getirir. Timestamp (milliseconds) ve GMT+3 olarak gönderilmelidir.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Belirtilen tarihe kadar olan siparişleri getirir. Timestamp (milliseconds) ve GMT+3 olarak gönderilmelidir.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Sadece belirtilen sayfadaki bilgileri döndürür.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Bir sayfada listelenecek maksimum adet. Maksimum 100.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100
            }
          },
          {
            "name": "orderNumber",
            "in": "query",
            "description": "Sipariş numarası ile sorgulama.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "packageIds",
            "in": "query",
            "description": "Paket numarası ile sorgulama.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Belirtilen statüdeki siparişleri getirir. Her istekte tek bir değer alır.",
            "schema": {
              "type": "string",
              "enum": [
                "Created",
                "Picking",
                "Shipped",
                "Cancelled",
                "Delivered",
                "Unpacked",
                "UnSupplied"
              ]
            }
          },
          {
            "name": "orderByDirection",
            "in": "query",
            "description": "ASC: eskiden yeniye, DESC: yeniden eskiye sıralar.",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "orderByField",
            "in": "query",
            "description": "true girildiğinde paketin lastModifiedDate alanına göre sorgulama yapılır; kaldırıldığında ya da false olduğunda tarih aralığı sipariş oluşturma tarihi olarak baz alınır (tablodaki tip: string). Lonca: the page's example URL spells it \"orderbyField\"; n11 support (2026-10-13) confirmed the true/false meaning.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "sender",
            "in": "query",
            "description": "Gönderici tipi: SELLER (satıcı gönderir), n11 (n11 depo gönderir), ALL (tümü). Gönderilmediği takdirde varsayılan değer SELLER olarak alınır. Lonca: this table writes \"n11\" where the product-query table and the response field write \"N11\".",
            "schema": {
              "type": "string",
              "default": "SELLER"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sipariş paketleri (sayfalı)",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentPackagesPage"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/siparis-listeleme-servisi/"
      }
    },
    "/rest/delivery/v1/splitCombinePackage": {
      "post": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Sipariş Paket Bölme",
        "operationId": "splitCombinePackage",
        "description": "Siparişler yalnızca Picking statüsünde bölünebilir; Created statüsündekiler bölünemez. Bölünen ana paketin statüsü Unpacked olur, bölünmüş paketler Picking statüsünde, aynı orderNumber, farklı id (paket numarası) ve farklı cargoTrackingNumber (kampanya kodu) ile oluşur. orderLineId değerleri GetShipmentPackages servisinden alınır. Gönderilen orderLineId'ler dışındaki ürünler otomatik olarak yeni bir pakette oluşur. Birden fazla ürün içeren bölünmüş paketler tekrar bölünebilir. Her splitGroups öğesi bir paket oluşturur.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "example",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SplitCombinePackageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oluşan paketler",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SplitPackageResult"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/siparis-paket-bolme/"
      }
    },
    "/rest/delivery/v1/splitPackageByQuantity": {
      "post": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Miktar Bazlı Paket Bölme & Sipariş Ürün İptali",
        "operationId": "splitPackageByQuantity",
        "description": "Siparişler yalnızca Picking statüsünde bölünebilir; Created statüsündekiler bölünemez. Bölünen ana paketin statüsü Unpacked olur, bölünmüş paketler Picking statüsünde, aynı orderNumber, farklı id (paket numarası) ve farklı cargoTrackingNumber (kampanya kodu) ile oluşur. orderLineId değerleri GetShipmentPackages servisinden alınır. quantities ile oluşacak paketteki ürün miktarı gönderilir; toplam sipariş ürün miktarını aşamaz. Body içinde yalnızca aynı siparişe ait ürünler bulunmalıdır. Bölme sonrası yeni ürün satırları için yeni orderLineId'ler üretilir. Bu servisle paket bölme ile birlikte parçalı ürün iptali yapılabilir, fakat yalnızca iptal yapılamaz; iptal edilen paket UnSupplied olur.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "example",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SplitPackageByQuantityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Oluşan paketler",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SplitPackageResult"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/miktar-bazli-paket-bolme-siparis-urun-iptali/"
      }
    },
    "/rest/order/v1/labor-costs": {
      "put": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Sipariş Kalemine İşçilik Bedeli Gönderme",
        "operationId": "updateLaborCosts",
        "description": "Hatalı ya da uygun olmayan orderLineId'ler için hata mesajı dönülür, kalanlar işleme alınır. Birden fazla orderLineId gönderilebilir. İşçilik KDV oranı varsayılan 20'dir. Hesaplama sonucu amountExcludingVAT alanında verilir. İşçilik bedeli eklenebilen kategoriler sayfadaki listede yer alır.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LaborCostsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Satır bazlı sonuç",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LaborCostResults"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/siparis-kalemine-iscilik-bedeli-gonderme/"
      }
    },
    "/rest/order/v1/update": {
      "put": {
        "tags": [
          "Sipariş"
        ],
        "summary": "Sipariş Kalemlerini Güncelleme",
        "operationId": "updateOrder",
        "description": "Şu an için yalnızca Picking statü güncellemesi (sipariş kalemlerini onaylama) yapılabilir. GetShipmentPackages servisinden Created dönen kalemler güncellenebilir. Hatalı ya da statüsü uygun olmayan lineId'ler için hata mesajı dönülür, kalanlar işleme alınır. lineId için orderLineId baz alınmalıdır; birden fazla lineId gönderilebilir, status tek olmalıdır.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Satır bazlı sonuç",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LineResults"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-siparis-entegrasyonu/siparis-kalemlerini-guncelleme-servisi/"
      }
    }
  },
