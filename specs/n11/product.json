  "paths": {
    "/cdn/categories": {
      "get": {
        "tags": [
          "Kategori"
        ],
        "summary": "Kategori Ağacı Listeleme",
        "operationId": "getCategories",
        "description": "Tüm n11 kategori ağacını tek istekle döner; parametre gerekmez. subCategories değerinin null dönmesi o kategorinin en alt kırılım olduğunu ifade eder. Ürün yükleme servisinde en alt kırılım olan kategorinin id değeri iletilmelidir. Sayfa yalnızca appKey başlığını ister; changelog'daki 2025-06-17 ve 2025-07-17 duyuruları kategori servislerinin 2025-08-15 itibarıyla API Key & Secret olmadan çalışmayacağını söyler, bu yüzden iki güvenlik seçeneği de listelenmiştir.",
        "security": [
          {
            "appKey": [],
            "appSecret": []
          },
          {
            "appKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kategori ağacı",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryTree"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/kategori-agaci-listeleme/"
      }
    },
    "/cdn/category/{categoryId}/attribute": {
      "get": {
        "tags": [
          "Kategori"
        ],
        "summary": "Kategori Özellikleri Listeleme",
        "operationId": "getCategoryAttributesList",
        "description": "Endpoint içindeki categoryId değerine göre kategoriye ait attribute'ları (id, value ve value id) listeler; request parametresi yoktur. isMandatory: true olan attribute'lar CreateProduct servisinde zorunludur. isVariant: true olan attribute için aynı productMainId ile gönderilen ürünler aynı sayfada seçenek olarak görünür. isCustomValue: true ise listeden bir valueId ya da customValue ile yeni bir değer iletilebilir.",
        "parameters": [
          {
            "name": "categoryId",
            "in": "path",
            "required": true,
            "description": "GetCategories servisinden alınan kategori id değeri.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "security": [
          {
            "appKey": [],
            "appSecret": []
          },
          {
            "appKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kategoriye ait özellikler ve değerleri",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryAttributes"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/kategori-ozellikleri-listeleme/"
      }
    },
    "/ms/product-query": {
      "get": {
        "tags": [
          "Ürün"
        ],
        "summary": "Satıcı Ürün Sorgulama",
        "operationId": "getSellerProducts",
        "description": "Request parametrelerinde zorunluluk yoktur; hiçbir parametre girilmediğinde satıcının tüm ürünleri page 0 size 20 olacak şekilde listelenir. stockCode her istekte tek bir değer alır. Sayfalama için page 0'dan başlayıp totalPages alanını dikkate alarak content'i boş dönen sayfa son sayfa kabul edilebilir. Response alanlarının karakter sayısı ve veri tipleri ürün sayısının artışıyla değişebilir (ör. n11ProductId 9 haneden 10 haneye çıkabilir).",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "n11 Ürün kodu ile listeleme.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "productMainId",
            "in": "query",
            "description": "Ürün grup kodu ile listeleme.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stockCode",
            "in": "query",
            "description": "Satıcı ürün kodu ile listeleme. Her istekte tek bir değer alır.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "saleStatus",
            "in": "query",
            "description": "Ürün satış durumuna göre listeleme. On_Sale: Satışta, Out_Of_Stock: Stokta Yok.",
            "schema": {
              "type": "string",
              "enum": [
                "On_Sale",
                "Out_Of_Stock"
              ]
            }
          },
          {
            "name": "productStatus",
            "in": "query",
            "description": "Ürün onay durumuna göre listeleme. Active: Onaylı, InCatalogApproval: Katalog Onay Sürecinde, Suspended: Beklemede, CatalogRejected: Katalogdan Reddedildi, Prohibited: Yasaklı, Unlisted: Limit Dışı, InApproval: Aksiyon Bekleyen.",
            "schema": {
              "type": "string",
              "enum": [
                "Active",
                "InCatalogApproval",
                "Suspended",
                "CatalogRejected",
                "Prohibited",
                "Unlisted",
                "InApproval"
              ]
            }
          },
          {
            "name": "brandName",
            "in": "query",
            "description": "Satıcı panelindeki ürünleri marka ismine göre listeler.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoryIds",
            "in": "query",
            "description": "Kategori ID ile listeleme (tablodaki tip: \"long list\"). Lonca: the page does not say how several values are encoded (comma-separated or repeated parameter).",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Sayfa numarası. Varsayılan 0.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Sayfa boyutu. Varsayılan 20, maksimum 250.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 250
            }
          },
          {
            "name": "sender",
            "in": "query",
            "description": "Gönderici tipi. SELLER: Satıcı gönderir, N11: n11 Depo gönderir, ALL: Tümü. Gönderilmediği takdirde varsayılan değer SELLER olarak alınır.",
            "schema": {
              "type": "string",
              "enum": [
                "SELLER",
                "N11",
                "ALL"
              ],
              "default": "SELLER"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Satıcının ürünleri (sayfalı)",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductQueryPage"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/satici-urun-sorgulama/"
      }
    },
    "/ms/product/task-details/page-query": {
      "post": {
        "tags": [
          "Ürün"
        ],
        "summary": "Task Detail Sorgulama",
        "operationId": "getTaskDetails",
        "description": "Ürün task'larının sonucunu sayfalı döner. itemCode ürünün stockCode değeridir; skus.content içindeki status ürün bazlı sonucu verir (SUCCESS veya FAIL), hata detayı reasons alanındadır. Ana seviyedeki status task'ın genel durumudur: PROCESSED işlem tamamlandı, IN_QUEUE işlem devam ediyor, REJECT task işleme alınmadı.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "example",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskDetailsRequest"
              },
              "example": {
                "taskId": 362,
                "pageable": {
                  "page": 0,
                  "size": 1000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task detayı",
            "x-lonca-doc-basis": "example",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetails"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/task-detail-sorgulama/"
      }
    },
    "/ms/product/tasks/price-stock-update": {
      "post": {
        "tags": [
          "Ürün"
        ],
        "summary": "Ürün Fiyat-Stok Güncelleme",
        "operationId": "updatePriceAndStock",
        "description": "İsteği JSON formatında body'de raw olarak gönderin. Tek seferde maksimum 1000 sku gönderilebilir. Her başarılı istek için response'ta ID (taskId) döner; işlemin sonucu TaskDetails servisi ile kontrol edilir. Fiyat güncellemelerinde listPrice ve salePrice birlikte gönderilmelidir; küsurat nokta ile ayrılmalı ve noktadan sonra 2 hane iletilmelidir, aksi halde istek FAIL olur. Sadece fiyat veya sadece stok güncellenecekse diğer alanlar gönderilmeyebilir; istekte olmayan alanlar güncellenmez. listPrice ve salePrice aynı olabilir; listPrice salePrice'tan düşük olamaz.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriceStockUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task oluşturuldu",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTask"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/urun-fiyat-stok-guncelleme/"
      }
    },
    "/ms/product/tasks/product-create": {
      "post": {
        "tags": [
          "Ürün"
        ],
        "summary": "Ürün Yükleme",
        "operationId": "createProduct",
        "description": "İsteği JSON formatında body'de raw olarak gönderin. Tek seferde maksimum 1000 sku gönderilebilir. Her başarılı istek için response'ta ID (taskId) döner; işlemin sonucu TaskDetails servisi ile kontrol edilir. Ürün yüklemeden önce zorunlu özellikler doldurulmalı ve customValue alanı kontrol edilmelidir (GetCategoryAttributesList). Ürün görsel boyutu maksimum 10 MB olmalıdır. Gönderilen barcode n11 kataloğundaki bir barkodla eşleşirse ürün, attribute özelliklerine bakılmaksızın satıcı onayı bekliyor statüsünde açılır. Ürün bazlı shipmentTemplate (kargo şablon adı) gönderilmelidir. Aynı productMainId ile gönderilen ve variant/slicer özelliği olan ürünler varyantlı açılır.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task oluşturuldu",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTask"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/urun-yukleme/"
      }
    },
    "/ms/product/tasks/product-delete": {
      "post": {
        "tags": [
          "Ürün"
        ],
        "summary": "Ürün Silme",
        "operationId": "deleteProduct",
        "description": "İsteği JSON formatında body'de raw olarak gönderin. Tek seferde maksimum 1000 sku gönderilebilir. Her başarılı istek için response'ta ID (taskId) döner; işlemin sonucu TaskDetails servisi ile kontrol edilir.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductDeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task oluşturuldu",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTask"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/urun-silme/"
      }
    },
    "/ms/product/tasks/product-update": {
      "post": {
        "tags": [
          "Ürün"
        ],
        "summary": "Ürün Bilgisi Güncelleme",
        "operationId": "updateProduct",
        "description": "İsteği JSON formatında body'de raw olarak gönderin. Tek seferde maksimum 1000 sku gönderilebilir. Her başarılı istek için response'ta ID (taskId) döner; işlemin sonucu TaskDetails servisi ile kontrol edilir. productMainId silinmek isteniyorsa deleteProductMainId true, maxPurchaseQuantity silinmek isteniyorsa deleteMaxPurchaseQuantity true gönderilmelidir (bu durumda satın alım adet sınırı olmadığı kabul edilir). attributes alanında stok kodu bazında ürün güvenliği attribute değerleri gönderilir; ürün temel özellikleri (Marka, Renk, Beden vb.) yalnızca n11 tarafından güncellenebilir. Güncellenebilecek ürün güvenliği ve besin değeri attribute id'leri sayfadaki \"Ürün Güvenliği Bilgileri ve Besin Değerleri\" tablosunda listelenir.",
        "requestBody": {
          "required": true,
          "x-lonca-doc-basis": "table",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task oluşturuldu",
            "x-lonca-doc-basis": "table",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTask"
                }
              }
            }
          }
        },
        "x-lonca-doc-url": "https://developer.n11.com/documentation/n11-marketplace-entegrasyonu/urun-bilgisi-guncelleme/"
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "parentId": {
            "type": "integer",
            "format": "int64",
            "description": "Üst kategori id; kök kategorilerde null.",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "subCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "Alt kategoriler. null ise kategori en alt kırılımdır (leaf).",
            "nullable": true
          }
        }
      },
      "CategoryAttribute": {
        "type": "object",
        "properties": {
          "attributeId": {
            "type": "integer",
            "format": "int64",
            "description": "Özellik id (ör. 1: Marka)."
          },
          "categoryId": {
            "type": "integer",
            "format": "int64"
          },
          "attributeName": {
            "type": "string"
          },
          "isMandatory": {
            "type": "boolean",
            "description": "true ise CreateProduct servisinde ürün bazlı gönderilmesi zorunludur."
          },
          "isVariant": {
            "type": "boolean",
            "description": "true ise aynı productMainId ile gönderilen ürünler aynı sayfada seçenek olarak görünür."
          },
          "isSlicer": {
            "type": "boolean"
          },
          "isCustomValue": {
            "type": "boolean",
            "description": "true ise listeden bir valueId ya da customValue ile yeni bir değer iletilebilir."
          },
          "isN11Grouping": {
            "type": "boolean"
          },
          "attributeOrder": {
            "type": "integer",
            "format": "int32"
          },
          "attributeValues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Değer id (valueId)"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            "description": "Özelliğin n11 tarafından tanımlı değerleri."
          }
        }
      },
      "CategoryAttributes": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Kategori id"
          },
          "name": {
            "type": "string",
            "description": "Kategori adı"
          },
          "categoryAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryAttribute"
            }
          }
        }
      },
      "CategoryTree": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "description": "Kök kategoriler (parentId: null)."
          }
        }
      },
      "PriceStockUpdateRequest": {
        "type": "object",
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "integrator",
              "skus"
            ],
            "properties": {
              "integrator": {
                "type": "string",
                "description": "Entegratör ve API kullanıcısının verilebilecek özel ismi. Tüm gönderimlerinizde aynı değer kullanmanızı rica ederiz."
              },
              "skus": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PriceStockUpdateSku"
                },
                "description": "Tek seferde maksimum 1000 sku.",
                "x-lonca-doc-example-only": true
              }
            },
            "x-lonca-doc-example-only": true
          }
        }
      },
      "PriceStockUpdateSku": {
        "type": "object",
        "required": [
          "stockCode"
        ],
        "properties": {
          "stockCode": {
            "type": "string",
            "description": "Tedarikçinin ürüne belirlediği uniq kod; SKU güncellemelerinde zorunludur."
          },
          "listPrice": {
            "type": "number",
            "description": "Ürün liste fiyatı (PSF). Fiyat güncellemesinde salePrice ile birlikte zorunludur."
          },
          "salePrice": {
            "type": "number",
            "description": "Ürün satış fiyatı (TSF). Fiyat güncellemesinde listPrice ile birlikte zorunludur."
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "description": "Stok miktarı."
          },
          "currencyType": {
            "type": "string",
            "enum": [
              "TL",
              "USD",
              "EUR"
            ],
            "description": "Ürün liste fiyatı para birimi (tablodaki tip: text)."
          }
        }
      },
      "ProductCreateRequest": {
        "type": "object",
        "required": [
          "payload"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "integrator",
              "skus"
            ],
            "properties": {
              "integrator": {
                "type": "string",
                "description": "API Kullanıcı/Entegratör Firma ismini yazınız. Tüm gönderimlerinizde aynı ismi iletiniz."
              },
              "skus": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProductCreateSku"
                },
                "description": "Tek seferde maksimum 1000 sku.",
                "x-lonca-doc-example-only": true
              }
            },
            "x-lonca-doc-example-only": true
          }
        }
      },
      "ProductCreateSku": {
        "type": "object",
        "required": [
          "title",
          "description",
          "categoryId",
          "currencyType",
          "productMainId",
          "preparingDay",
          "shipmentTemplate",
          "stockCode",
          "quantity",
          "images",
          "attributes",
          "salePrice",
          "listPrice",
          "vatRate"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Ürün ismi; marka, cinsiyet, renk veya ürün bilgisini ekleyerek yazabilirsiniz."
          },
          "description": {
            "type": "string",
            "description": "Ürüne ait açıklamalar (tablodaki tip: HTML-string)."
          },
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "description": "GetCategories servisinden alınan kategorinin en alt kırılım id değeri."
          },
          "currencyType": {
            "type": "string",
            "enum": [
              "TL",
              "USD",
